{
  "name": "signalk-alert-console",
  "version": "0.1.0",
  "description": "Reference alerts UI for the Signal K core alerts API",
  "type": "module",
  "files": [
    "public/**",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "signalk-webapp",
    "signalk-category-utility",
    "signalk",
    "alerts",
    "alarms",
    "alert-console"
  ],
  "signalk": {
    "displayName": "Alert Console",
    "appIcon": "assets/icon-72x72.png"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.tools.json",
    "lint": "eslint src test tools",
    "lint:fix": "eslint --fix src test tools",
    "format": "prettier --write \"src/**/*.{ts,html}\" \"test/**/*.ts\" \"tools/**/*.mjs\" \"*.config.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html}\" \"test/**/*.ts\" \"tools/**/*.mjs\" \"*.config.{ts,js}\"",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hatlabs/signalk-alert-console.git"
  },
  "author": "Hat Labs Oy",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/hatlabs/signalk-alert-console/issues"
  },
  "homepage": "https://github.com/hatlabs/signalk-alert-console#readme",
  "dependencies": {
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "happy-dom": "^20.6.1",
    "lefthook": "^1.11.13",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.29.1",
    "vite": "^6.3.0",
    "vitest": "^3.1.1"
  }
}
